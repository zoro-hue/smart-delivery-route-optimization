# ROUTE/IQ — Frontend Deployment Environment Variables
# --------------------------------------------------------
# For production deployments (e.g. Vercel, Netlify, Render Static Site):
# Set VITE_API_URL to the public HTTPS URL of your deployed backend.
# Example: VITE_API_URL=https://routeiq-backend.onrender.com
#
# For local development:
# Leave blank (default). Vite's dev server will proxy '/api' to http://127.0.0.1:8000.
VITE_API_URL=
