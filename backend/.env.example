# ROUTE/IQ — Backend Environment Configuration Example
# ═════════════════════════════════════════════════════════════
# Copy this file to .env or set these environment variables in your cloud hosting provider.

# Server Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Platform Host & Port (cloud platforms like Render/Railway automatically inject PORT)
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins
# Specify your deployed frontend URL(s), comma-separated.
# Example: https://routeiq.vercel.app,https://routeiq.netlify.app
FRONTEND_URL=https://routeiq-frontend.vercel.app
ALLOWED_ORIGINS=https://routeiq-frontend.vercel.app,https://routeiq.netlify.app,http://localhost:5173

# Optional: CORS Origin Regex pattern (defaults to matching vercel, netlify, and render)
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$|^https:\/\/.*\.netlify\.app$|^https:\/\/.*\.onrender\.com$

# Database (defaults to local SQLite at data/sdro.db if left blank)
# To use managed PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
USE_POSTGRES=false
DATABASE_URL=

# Optimization Configuration
MAX_CUSTOMERS_CLASSICAL=200
MAX_CUSTOMERS_QAOA=8
CLASSICAL_SOLVER_TIME_LIMIT_SEC=30
